{
  "luci-app-advanced": {
    "description": "Grant UCI and Filesystem access to LuCI app advanced",
    "read": {
      "file": {
        "/sbin/logread -e wifi": [ "exec" ],
        "/sbin/wifi": [ "exec" ],
        "/usr/sbin/logread -e wifi": [ "exec" ],
        "/etc/modules.d/mt7915e": [ "read" ]
      },
      "ubus": {
        "file": [ "read" ]
      },
      "uci": [ "advanced", "mtkhnat" ]
    },
    "write": {
      "file": {
        "/sbin/mtkhnat": [ "exec" ],
        "/etc/modules.d/mt7915e": [ "write" ]
      },
      "ubus": {
        "file": [ "write" ]
      },
      "uci": [ "advanced", "mtkhnat" ]
    }
  }
}